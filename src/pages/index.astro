---
import Site from "../layouts/Site.astro";
import InteractiveReview from "../components/InteractiveReview.astro";
import DeliverableSection from "../components/DeliverableSection.astro";
import { t } from "../i18n";

const base = import.meta.env.BASE_URL;

const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Single product-page review",
  serviceType: "Product-page review",
  provider: { "@type": "Organization", name: "Storefront Clinic" },
  offers: {
    "@type": "Offer",
    price: "60",
    priceCurrency: "USD",
    description: "One product page, desktop and mobile viewports, evidence-led report with up to three priorities.",
  },
};
---

<Site title="Storefront Clinic — Storefront reviews & improvements (portfolio edition)">
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow" data-i18n="hero.eyebrow">Small details. A different experience.</p>
      <h1>
        <span data-i18n="hero.t1">Good products.</span><br />
        <em data-i18n="hero.t2">Fewer question marks.</em>
      </h1>
      <p class="lede" data-i18n="hero.lede">See what makes a shopper hesitate. Turn your product page into a clearer buying experience, one considered improvement at a time.</p>
      <div class="actions">
        <a class="button" href={`${base}contact/`} data-i18n="hero.cta1">Discuss your page <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={`${base}sample/`} data-i18n="hero.cta2">See the sample report →</a>
      </div>
    </div>
    <InteractiveReview />
  </section>

  <section class="wrap service-section section reveal" id="service">
    <div class="section-heading">
      <p class="eyebrow" data-i18n="service.eyebrow">Small scope. Thoughtful work.</p>
      <h2><span data-i18n="service.t1">See your page</span><br /><span data-i18n="service.t2">through a shopper's eyes.</span></h2>
      <p data-i18n="service.lede">One product page. One visitor action. A human-reviewed look at what shoppers see, understand and do next.</p>
      <a class="text-link" href={`${base}about/`} data-i18n="service.link">Our approach ↗</a>
    </div>
    <div class="review-topics">
      <article>
        <span class="topic-number" aria-hidden="true">01</span>
        <div>
          <h3 data-i18n="service.t1h">Make the offer clear.</h3>
          <p data-i18n="service.t1p">Product details, quantities and options. Can a shopper understand exactly what they are choosing?</p>
        </div>
      </article>
      <article>
        <span class="topic-number" aria-hidden="true">02</span>
        <div>
          <h3 data-i18n="service.t2h">Find the friction.</h3>
          <p data-i18n="service.t2p">Check the observable journey. Separate reproducible issues from recommendations and untested assumptions.</p>
        </div>
      </article>
      <article>
        <span class="topic-number" aria-hidden="true">03</span>
        <div>
          <h3 data-i18n="service.t3h">Leave with a useful plan.</h3>
          <p data-i18n="service.t3p">Dated evidence, up to three supported priorities, and one annotated improvement concept or copy comparison.</p>
        </div>
      </article>
    </div>
  </section>

  <DeliverableSection />

  <section class="wrap offer reveal">
    <div>
      <p class="eyebrow" data-i18n="offer.eyebrow">The single-page review</p>
      <h2><span data-i18n="offer.t1">A small start.</span><br /><span data-i18n="offer.t2">A concrete deliverable.</span></h2>
      <ul class="checks">
        <li data-i18n="offer.c1">One product page, desktop and mobile viewports</li>
        <li data-i18n="offer.c2">Evidence-led English report and test limitations</li>
        <li data-i18n="offer.c3">Up to three priorities, where supported by evidence</li>
        <li data-i18n="offer.c4">One improvement concept and one factual revision</li>
      </ul>
    </div>
    <div class="price">
      <span data-i18n="offer.priceLabel">Proposed introductory fee</span>
      <strong>USD 60</strong>
      <p data-i18n="offer.delivery">Within 2 business days after scope agreement and complete inputs.</p>
      <a class="button" href={`${base}contact/`} data-i18n="offer.cta">Check whether it's a fit ↗</a>
      <small data-i18n="offer.note">Written quote and payment terms agreed before work. Implementation and third-party costs excluded.</small>
    </div>
  </section>

  <section class="wrap section process reveal">
    <div class="section-heading">
      <h2 data-i18n="process.title">From a page to a plan.</h2>
    </div>
    <div class="steps">
      <article>
        <span class="step-number" aria-hidden="true">01</span>
        <h3 data-i18n="process.s1h">Share the goal.</h3>
        <p data-i18n="process.s1p">Your URL, market and intended visitor action. No administrator password needed.</p>
      </article>
      <article>
        <span class="step-number" aria-hidden="true">02</span>
        <h3 data-i18n="process.s2h">Agree the scope.</h3>
        <p data-i18n="process.s2p">Confirm checks, fee and delivery. If access prevents testing, agree an alternative before proceeding.</p>
      </article>
      <article>
        <span class="step-number" aria-hidden="true">03</span>
        <h3 data-i18n="process.s3h">Review the evidence.</h3>
        <p data-i18n="process.s3p">Receive observations and recommendations. Small implementation work can be quoted separately.</p>
      </article>
    </div>
  </section>

  <section class="wrap safety reveal">
    <div>
      <h2><span data-i18n="safety.t1">Your live store</span><br /><span data-i18n="safety.t2">deserves care.</span></h2>
    </div>
    <p data-i18n="safety.p">Implementation starts with agreed permissions, backup coverage and a preview or unpublished theme. Publishing needs your approval. Recovery depends on your platform and apps; we don't promise zero data loss or guaranteed conversion gains.</p>
  </section>

  <section class="wrap section faq reveal">
    <h2 data-i18n="faq.title">Before we start.</h2>
    <details>
      <summary data-i18n="faq.q1">Is this an automated AI audit?</summary>
      <p data-i18n="faq.a1">This is a human-reviewed service supported by tools. Findings are checked and limitations disclosed; an automated score alone is not the deliverable.</p>
    </details>
    <details>
      <summary data-i18n="faq.q2">Do you need access to my store admin?</summary>
      <p data-i18n="faq.a2">Not for the public product-page review. Implementation access is scoped separately. Never send passwords, payment data or customer exports with your initial request.</p>
    </details>
    <details>
      <summary data-i18n="faq.q3">Can you guarantee more sales?</summary>
      <p data-i18n="faq.a3">No. Acceptance is based on the agreed report and evidence, not a sales target. Recommendations can be tested later with suitable traffic and measurement.</p>
    </details>
    <details>
      <summary data-i18n="faq.q4">Is the sample a real client case?</summary>
      <p data-i18n="faq.a4">No. It is a clearly labelled self-created demonstration. We do not present sample work as paid client results.</p>
    </details>
  </section>

  <section class="closing wrap reveal">
    <img src={`${base}brand/mark.svg`} width="80" height="80" alt="" />
    <h2><span data-i18n="closing.t1">Start with one page.</span><br /><em data-i18n="closing.t2">Let's make it clearer.</em></h2>
    <a class="button" href={`${base}contact/`} data-i18n="closing.cta">Prepare your review brief ↗</a>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceLd)} />
</Site>
