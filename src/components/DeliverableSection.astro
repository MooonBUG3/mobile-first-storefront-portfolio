---
// Deliverable explainer with a three-tab switcher. Tabs are row-wrapped on
// mobile with 44px touch targets; the panel reserves a min-height so tab
// switches never shift the page (CLS guard).
const base = import.meta.env.BASE_URL;
---

<section class="wrap deliverable-section">
  <div class="section-heading">
    <p class="eyebrow" data-i18n="deliver.eyebrow">Open the deliverable</p>
    <h2><span data-i18n="deliver.t1">More than a score.</span><br /><span data-i18n="deliver.t2">Something you can use.</span></h2>
  </div>
  <div class="deliverable-controls" hidden role="group" aria-label="Explore report contents" data-i18n-aria="deliver.controls">
    <button type="button" data-report="0" aria-pressed="true" data-i18n="deliver.tab1">The evidence</button>
    <button type="button" data-report="1" aria-pressed="false" data-i18n="deliver.tab2">The priorities</button>
    <button type="button" data-report="2" aria-pressed="false" data-i18n="deliver.tab3">The next step</button>
  </div>
  <div class="deliverable-panel" aria-live="polite" aria-atomic="true">
    <span class="deliverable-number" id="report-number" aria-hidden="true">01</span>
    <div>
      <h3 id="report-title" data-i18n="deliver.p1h">See exactly what we saw.</h3>
      <p id="report-description" data-i18n="deliver.p1p">The page, viewport, observation date and reproducible steps. Screenshots give every finding a place and a context.</p>
      <a class="text-link" href={`${base}sample/`} data-i18n="deliver.link">Explore the sample report →</a>
    </div>
  </div>
</section>

<script>
  import { dictionaries, type Lang } from "../i18n";

  const controls = document.querySelector<HTMLElement>(".deliverable-controls");
  if (controls) controls.hidden = false;

  const reports: [string, string][] = [
    ["deliver.p1h", "deliver.p1p"],
    ["deliver.p2h", "deliver.p2p"],
    ["deliver.p3h", "deliver.p3p"],
  ];
  let lang: Lang = (document.documentElement.dataset.lang as Lang) || "en";
  let current = 0;

  const render = (animate: boolean) => {
    const d = dictionaries[lang] as Record<string, string>;
    const [hKey, pKey] = reports[current];
    const title = document.getElementById("report-title");
    const description = document.getElementById("report-description");
    const number = document.getElementById("report-number");
    if (title) title.textContent = d[hKey];
    if (description) description.textContent = d[pKey];
    if (number) number.textContent = "0" + (current + 1);
    document.querySelectorAll<HTMLButtonElement>("[data-report]").forEach((item) => {
      item.setAttribute("aria-pressed", String(Number(item.dataset.report) === current));
    });
    if (animate && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.querySelector(".deliverable-panel")?.animate(
        [{ opacity: 0.3, transform: "translateY(12px)" }, { opacity: 1, transform: "translateY(0)" }],
        { duration: 360, easing: "ease-out" },
      );
    }
  };

  document.querySelectorAll<HTMLButtonElement>("[data-report]").forEach((b) =>
    b.addEventListener("click", () => {
      current = Number(b.dataset.report);
      render(true);
    }),
  );

  document.addEventListener("langchange", (event) => {
    lang = (event as CustomEvent<{ lang: Lang }>).detail.lang;
    render(false);
  });
</script>
