---
// Mobile-first header: brand + hamburger below 48em, inline nav from 48em up.
// The nav element is a single instance shared by both layouts; the language
// toggle lives inside it so it appears in the mobile drawer and the desktop
// bar alike. With JS disabled the nav renders as a static stacked list.
import { t } from "../i18n";

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const current = (href: string) =>
  href === base ? path === base || path === `${base}index.html` : path.startsWith(href);
---

<header class="header" id="site-header" data-open="false">
  <div class="header-inner">
    <a class="brand" href={base} aria-label="Storefront Clinic — home">
      <img src={`${base}brand/mark.svg`} width="46" height="46" alt="" />
      <span data-i18n="brand.name">Storefront Clinic</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Menu"
      data-i18n-aria="nav.menu"
    >
      <span class="nav-toggle-bars" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main navigation">
      <a href={`${base}#service`} aria-current={current(`${base}#service`) ? "page" : undefined} data-i18n="nav.review">The review</a>
      <a href={`${base}sample/`} aria-current={path.startsWith(`${base}sample`) ? "page" : undefined} data-i18n="nav.sample">Sample report</a>
      <a href={`${base}about/`} aria-current={path.startsWith(`${base}about`) ? "page" : undefined} data-i18n="nav.about">About</a>
      <a class="nav-cta" href={`${base}contact/`} aria-current={path.startsWith(`${base}contact`) ? "page" : undefined} data-i18n="nav.cta">Let's talk ↗</a>
      <button class="lang-toggle" type="button" aria-label="Switch language" data-i18n-aria="lang.aria" data-i18n="lang.zh">中文</button>
    </nav>
  </div>
</header>
