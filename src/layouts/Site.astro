---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyCta from "../components/StickyCta.astro";
import { LANG_STORAGE_KEY } from "../i18n";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Focused product-page reviews for independent stores. Clear evidence, practical recommendations and carefully scoped implementation." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <script is:inline>
      // Early flags: mark JS availability (no-flash mobile nav) and park a
      // stored Chinese preference as "pending" so translated nodes stay
      // invisible until the client swaps them (see lang.ts + base.css).
      document.documentElement.dataset.js = "on";
      try {
        var saved = localStorage.getItem("storefront-clinic:lang");
        if (saved === "zh") document.documentElement.dataset.pendingLang = "zh";
      } catch (e) {
        /* private mode: keep English */
      }
    </script>
  </head>
  <body>
    <a href="#main" class="skip" data-i18n="nav.skip">Skip to content</a>
    <div class="top-strip">
      <p>
        <span data-i18n="strip.text">Portfolio edition · mobile-first rebuild of a production storefront site ·</span>
        <a href="https://github.com/MooonBUG3/mobile-first-storefront-portfolio" target="_blank" rel="noopener noreferrer" data-i18n="strip.link">GitHub repo ↗</a>
      </p>
    </div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyCta />
    <script>
      import "../scripts/ui";
      import "../scripts/lang";
      import "../scripts/reveal";
    </script>
  </body>
</html>
